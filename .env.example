# Copy to .env and edit. Every value here is already the built-in default,
# so an absent .env is fine.

# From: docker ps --format '{{.Names}}'
VLLM_CONTAINER=vllm-vllm-1

# Under network_mode: host, vLLM is on the host's loopback.
VLLM_METRICS_URL=http://127.0.0.1:8000/metrics

# Host networking means no port mapping to hide behind. Keep this on loopback
# on a shared machine and point cloudflared at 127.0.0.1:8501.
BIND_HOST=127.0.0.1
BIND_PORT=8501

POLL_INTERVAL=2
HISTORY_MINUTES=30

# 1 includes /health and /metrics polls in the activity feed.
SHOW_HEALTH_LOGS=0
LOG_TAIL=200

# 0 runs without the Docker socket: no activity feed, no endpoint counts,
# and no address discovery when the metrics URL is wrong.
READ_DOCKER_LOGS=1
